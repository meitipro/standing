# The deployed Standing contract, and the network it lives on: studio,
# bradbury or asimov. An address only means something on its own network, and
# the network defaults to studio, where the contract is deployed. Until the
# address is set the site shows empty states and refuses every write with a
# sentence saying why.
NEXT_PUBLIC_STANDING_ADDRESS=
NEXT_PUBLIC_GENLAYER_NETWORK=studio

# Public origin, used in citations, share cards and the API examples. On
# Vercel it can stay unset: the production domain is used.
NEXT_PUBLIC_ORIGIN=

# ---------------------------------------------------------------------------
# Deployment only. Never in this file and never in Vercel: it is a spending
# key. Read it into the shell for the one command that needs it, in Git Bash:
#
#   read -s -p "key: " STANDING_DEPLOYER_KEY && export STANDING_DEPLOYER_KEY && echo
#   npm run deploy -- --fund
#
# The site itself holds no key. Everyone signs with their own wallet.
# ---------------------------------------------------------------------------
