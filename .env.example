# The deployed Standing contract on Bradbury. Until this is set the site runs
# from the seeded records in lib/seed.ts and every write is refused with a
# message that says so, rather than failing somewhere deeper.
NEXT_PUBLIC_STANDING_ADDRESS=

# Public origin, used for citations, open graph cards and the api examples.
NEXT_PUBLIC_ORIGIN=https://standing.wtf

# ---------------------------------------------------------------------------
# Deployment only. Do NOT put this in .env.local and never commit it: it is a
# spending key. Export it in the shell for the one command that needs it:
#
#   $env:STANDING_DEPLOYER_KEY = "0x..."    # PowerShell
#   npm run deploy
#
# The rpc endpoint and the explorer are deliberately not configurable here.
# They are read from the chain definition inside genlayer-js so they cannot
# drift out of sync with the network the client actually talks to.
# ---------------------------------------------------------------------------
# STANDING_DEPLOYER_KEY=
